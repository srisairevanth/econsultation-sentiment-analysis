# Copy this file to ".env" and fill in real values. Never commit the actual .env file.

# Required for the U.S. Financial Regulatory AI Assistant (Part 6)
# Get a free key at https://aistudio.google.com/apikey
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-3.8-flash

# Used by extraction/comments_extractor.py (Part 1 - Regulations.gov pull).
# Get a free key at https://api.data.gov/signup
REGULATIONS_API_KEY=your_regulations_gov_api_key_here

# Used by labeling_cleaning/label_comments.py (Stage 2 - local LLM labeling).
# Local Ollama only - never point these at a cloud AI service.
OLLAMA_HOST=http://127.0.0.1:11434
OLLAMA_MODEL=qwen3:8b
OLLAMA_TEMPERATURE=0
OLLAMA_SEED=42
SAVE_EVERY=5
MAX_RETRIES=3
COMMENT_COLUMN=comment

# Optional: explicit path to the LLM-labeled dataset (comment,label CSV) if you
# want to point at a different file than this project's own
# data/labeled/labeled_comments.csv (see config.LABELED_DATA_CANDIDATES).
LABELED_DATASET_PATH=
